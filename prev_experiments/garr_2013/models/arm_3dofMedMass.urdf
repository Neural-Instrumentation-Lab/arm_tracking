<?xml version="1.0"?>
<robot name="three_link_robot">
  <!-- ========================= -->
  <!-- Materials -->
  <!-- ========================= -->
  <material name="gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1"/>
  </material>
  <material name="cyan">
    <color rgba="0.0 0.7 1.0 1"/>
  </material>
  <material name="lime">
    <color rgba="0.4 1.0 0.2 1"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <!-- ========================= -->
  <!-- Base Link -->
  <!-- ========================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- ===================================================== -->
  <!-- LINK 1 -->
  <!-- Length = 0.310 m -->
  <!-- ===================================================== -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.310"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.310"/>
      </geometry>
    </collision>

    <inertial>
      <!-- COM from table -->
      <origin xyz="0.0 0.01698 -0.05913" rpy="0 0 0"/>
      <mass value="2.7082"/>
      <inertia
        ixx="0.0216417"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0214810"
        iyz="0.0022034"
        izz="0.0049639"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <!-- Assumed rotation axis -->
    <axis xyz="0 -1 0"/>
    <limit lower="-3.1416" upper="3.1416"
           effort="100" velocity="2.0"/>
    <dynamics damping="0.0020" friction="0.35"/>
  </joint>

  <!-- ===================================================== -->
  <!-- LINK 2 -->
  <!-- Length = 0.400 m -->
  <!-- ===================================================== -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.400"/>
      </geometry>
      <material name="cyan"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.400"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.11090 0.01410" rpy="0 0 0"/>
      <mass value="2.7100"/>
      <inertia
        ixx="0.0244442"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0052508"
        iyz="0.0036944"
        izz="0.0239951"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <!-- Attached at end of link1 -->
    <origin xyz="0 0 0.310" rpy="0 1.57 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.1416" upper="3.1416"
           effort="100" velocity="2.0"/>
    <dynamics damping="0.001698" friction="0.35"/>
  </joint>

  <!-- ===================================================== -->
  <!-- LINK 3 -->
  <!-- Length = 0.390 m -->
  <!-- ===================================================== -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.195" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.390"/>
      </geometry>
      <material name="lime"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.195" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.390"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 -0.01628 -0.06621" rpy="0 0 0"/>
      <mass value="2.5374"/>
      <inertia
        ixx="0.0213026"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0210353"
        iyz="0.0022204"
        izz="0.0046970"/>
    </inertial>
  </link>


  <joint name="joint3" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416"
           effort="100" velocity="2.0"/>
    <dynamics damping="0.00166" friction="0.35"/>
  </joint>


  <!-- ===================================================== -->
  <!-- END-EFFECTOR LINK                                     -->
  <!-- Sphere radius = 0.03 m                               -->
  <!-- Mass = 1.500 kg  (introduced error)                  -->
  <!-- Inertia: solid sphere, I = 2/5 * m * r^2            -->
  <!--   = 2/5 * 0.5 * 0.03^2 = 5.4e-4 kg·m^2             -->
  <!-- ===================================================== -->
  <link name="ee_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <!-- COM at sphere centre, offset 0.03 m along Z (matching visual) -->
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="1.500"/>
      <!-- Solid sphere: Ixx = Iyy = Izz = 2/5 * m * r^2 -->
      <inertia
        ixx="5.4e-4"
        ixy="0.0"
        ixz="0.0"
        iyy="5.4e-4"
        iyz="0.0"
        izz="5.4e-4"/>
    </inertial>
  </link>

<joint name="ee_fixed_joint" type="fixed">
  <parent link="link3"/>
  <child link="ee_link"/>
  <!-- attach at end of link3 -->
  <origin xyz="0 0 0.390" rpy="0 0 0"/>
</joint>
</robot>