<?xml version="1.0"?>
<robot name="two_link_robot">

  <!-- ========================= -->
  <!-- Materials -->
  <!-- ========================= -->

  <material name="gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4 0.0 1"/>
  </material>

  <material name="cyan">
    <color rgba="0.0 0.7 1.0 1"/>
  </material>

  <material name="lime">
    <color rgba="0.4 1.0 0.2 1"/>
  </material>

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>

  <!-- ========================= -->
  <!-- Base Link -->
  <!-- ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- ===================================================== -->
  <!-- LINK 1 : 0.31 m -->
  <!-- ===================================================== -->

  <link name="link1">

    <visual>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.31"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.31"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.01698 -0.05913" rpy="0 0 0"/>
      <mass value="2.7082"/>
      <inertia
        ixx="0.0216417"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0214810"
        iyz="0.0022034"
        izz="0.0049639"/>
    </inertial>

  </link>

  <!-- ===================================================== -->
  <!-- LINK 2 : 0.50 m -->
  <!-- ===================================================== -->

  <link name="link2">

    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.50"/>
      </geometry>
      <material name="cyan"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.50"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.11090 0.01410" rpy="0 0 0"/>
      <mass value="2.7100"/>
      <inertia
        ixx="0.0244442"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0052508"
        iyz="0.0036944"
        izz="0.0239951"/>
    </inertial>

  </link>

  <!-- ===================================================== -->
  <!-- LINK 3 : 0.49 m -->
  <!-- ===================================================== -->

  <link name="link3">

    <visual>
      <origin xyz="0 0 0.245" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.49"/>
      </geometry>
      <material name="lime"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.245" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.49"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 -0.01628 -0.06621" rpy="0 0 0"/>
      <mass value="2.5374"/>
      <inertia
        ixx="0.0213026"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0210353"
        iyz="0.0022204"
        izz="0.0046970"/>
    </inertial>

  </link>

  <!-- ===================================================== -->
  <!-- JOINTS -->
  <!-- ===================================================== -->

  <joint name="joint3" type="fixed">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>

    <!-- Attached at end of link1 -->
    <origin xyz="0 0 0.31" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-3.1416"
      upper="3.1416"
      effort="100"
      velocity="2.0"/>

    <dynamics
      damping="0.001698"
      friction="0.35"/>
  </joint>

  <joint name="joint1" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>

    <!-- Attached at end of link2 -->
    <origin xyz="0 0 0.50" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-3.1416"
      upper="3.1416"
      effort="100"
      velocity="2.0"/>

    <dynamics
      damping="0.0020"
      friction="0.35"/>
  </joint>

  <!-- ===================================================== -->
  <!-- END EFFECTOR -->
  <!-- ===================================================== -->

  <link name="ee_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="ee_fixed_joint" type="fixed">
    <parent link="link3"/>
    <child link="ee_link"/>

    <!-- Attached at end of link3 -->
    <origin xyz="0 0 0.49" rpy="0 0 0"/>
  </joint>

</robot>